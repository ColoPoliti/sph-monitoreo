# Valores para DESARROLLO o grabados al compilar. Copiar como .env.local y ajustar. Todas son opcionales.
#
# En el SERVIDOR no hace falta: se usa public/config.env (queda en la raíz de dist/),
# que se edita sin recompilar y tiene prioridad sobre estas variables.

# --- Monitoreo (MQTT por WebSocket; el usuario debe ser de SOLO LECTURA) ---
# La web usa /mqtt (config.env). En desarrollo, Vite lo redirige a este broker:
MQTT_DESTINO=ws://10.200.1.243:9001
VITE_MQTT_USER=web_lectura
# La contraseña MQTT se pide al equipo (no se sube a git)
VITE_MQTT_PASS=
VITE_BROKER_ETIQUETA=10.200.1.243

# --- API PHP (en desarrollo /api la redirige el proxy de Vite) ---
VITE_API_BASE=/api
# Destino del proxy /api de Vite (solo desarrollo: npm run dev / preview)
API_DESTINO=http://10.200.1.243:8080

# --- Credenciales PROVISORIAS (se validan en el navegador hasta tener login real) ---
# Si no se definen: admin/admin y usuario/usuario
VITE_ADMIN_USER=admin
VITE_ADMIN_PASS=
VITE_USUARIO_USER=usuario
VITE_USUARIO_PASS=
